# Chuỗi kết nối Supabase: Project → Connect → "Session pooler" (IPv4). Thay [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Chuỗi bí mật ký token đăng nhập, >= 32 ký tự. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Tùy chọn
SESSION_HOURS=12
# PA_PATTERN=PA\d{8}
# LOC_PATTERN=[A-Z]\d{2}-\d{2}-\d{2}
