# Chuỗi kết nối Supabase: Project → Connect → "Session pooler" (IPv4). Thay [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Chuỗi bí mật ký token đăng nhập, >= 32 ký tự. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Tên DC hiển thị trên giao diện và phiếu in (mỗi DC một giá trị)
APP_DC_NAME=DC Phú Thọ
APP_DC_SITE=1393 – WMP_AMBIENT_PHUTHO

# Kho trên WMS. DC Phú Thọ: PTD. DC Bình Dương: BD1E1 (đổi cả WMS_API_BASE)
WMS_WH_CODE=PTD
# WMS_API_BASE=https://api-supra.winmart.vn/sft3-bd1e1
# Ô trong Google Sheet chứa link session. Nhiều kho thì liệt kê nhiều ô, cách nhau dấu phẩy,
# thêm ":<mã kho>" khi một file session chứa nhiều kho:
#   WMS_SESSION_RANGE=Config!B4:BD1E1,Config!B3:BDD
# Mỗi ô là 1 kho; app tự lấy mã kho trong file session (WMS_WH_CODE là kho bắt buộc phải có).
WMS_SESSION_RANGE=Config!B2

# Danh sách site của DC (hiện trong ô chọn site, kể cả khi chưa đồng bộ WMS)
# APP_SITES=1379,1312

# Tùy chọn
SESSION_HOURS=12
# PA_PATTERN=PA\d{8}
# LOC_PATTERN=[A-Z]\d{2}-\d{2}-\d{2}

# --- Module WMS (tồn kho theo Bin) ---
# Service account Google đọc session WMS từ Google Sheet "Central OPS" tab Config ô B2.
# Railway: dán TOÀN BỘ nội dung file JSON vào biến GOOGLE_SERVICE_ACCOUNT_JSON.
# Local: có thể trỏ tới file bằng GOOGLE_SERVICE_ACCOUNT_FILE=đường/dẫn/file.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# WMS_SESSION_RANGE=Config!B2
# WMS_WH_CODE=PTD
